{
  "compileOnSave": false,
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "@/shared/ui/button": ["./src/shared/ui/button/src/index.ts"],
      "@/pages/task-list/providers": ["./src/pages/task-list/api/provide-task-list.ts"],
      "@/shared/ui/icon": ["./src/shared/ui/icon/src/index.ts"],
      "@/shared/ui/utils": ["./src/shared/ui/utils/src/index.ts"],
      "@/shared/ui/input": ["./src/shared/ui/input/src/index.ts"],
      "@/shared/ui/checkbox": ["./src/shared/ui/checkbox/src/index.ts"],
      "@/shared/ui/separator": ["./src/shared/ui/separator/src/index.ts"]
    },
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve"
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true
  },
  "files": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.spec.json"
    }
  ]
}
