# 로컬 개발용 환경 변수. server/.env 로 복사해서 쓴다.
#
#   cp .env.example .env
#   docker compose up -d
#   ./gradlew bootRun
#
# 값은 compose.yaml 의 컨테이너와 맞춰 두었다. 자격 증명이 아니라 로컬 고정값이므로
# 그대로 써도 된다. 배포 환경의 값은 서버의 .env 에만 있다.

# 데이터베이스 — compose.yaml 의 postgres
# 다른 PostgreSQL 이 5432 를 쓰고 있으면 DEV_DB_PORT 를 바꾸고 DB_URL 의 포트도 함께 맞춘다.
DEV_DB_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/gentask
DB_USERNAME=gentask
DB_PASSWORD=gentask

# 세션 서명 키. 아무 문자열이나 쓰되 32바이트 이상을 권장한다.
#   openssl rand -hex 32
AUTH_SECRET=local-development-secret-change-me-0123456789abcdef
AUTH_COOKIE_SECURE=false

# 파일 보관소 — compose.yaml 의 minio
# 브라우저가 presigned URL 로 직접 접근하므로 endpoint 는 브라우저에서 닿는 주소여야 한다.
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=gentask
STORAGE_SECRET_KEY=gentask-dev-secret
STORAGE_BUCKET=gentask-dev
STORAGE_CREATE_BUCKET=true
# 로컬은 버킷이 이미 분리되어 있으므로 접두어를 두지 않는다.
STORAGE_KEY_PREFIX=

# 웹 푸시. 실제로 알림을 받으려면 직접 발급한다.
#   npx web-push generate-vapid-keys
# 알림 기능을 쓰지 않으면 아래 값으로 기동만 된다.
VAPID_PUBLIC_KEY=BJxKl3xQyPvRZ7hVJ1nQ8mZ4kL2wN6pT9sX0cY5aB3dE7fG1hI2jK4lM6nO8pQ0rS2tU4vW6xY8zA0bC2dE4f
VAPID_PRIVATE_KEY=aB3dE7fG1hI2jK4lM6nO8pQ0rS2tU4vW6xY8zA0bC2d
VAPID_SUBJECT=mailto:dev@example.com

# 메일. 비우면 발송이 실패하지만 기동은 된다.
# 회원가입 확인 코드는 로그로도 확인할 수 있다.
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@localhost

# 관리자 화면에 들어갈 계정. 비우면 아무도 들어가지 못한다.
ADMIN_EMAIL=
