# 편집기 공통 설정. 라인엔딩은 .gitattributes가 저장소 쪽 정본이고, 이 파일은 편집기 쪽을 맞춘다.
# Java 포맷의 정본은 Spotless(palantir-java-format)다 — 아래 값은 편집기가 새 줄을 만들 때의
# 기본값일 뿐이며, 최종 판정은 `./gradlew spotlessApply`가 한다 (.vscode/settings.json 참조).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.java]
indent_size = 4
max_line_length = 120

[*.{sql,md}]
indent_size = 4

[*.md]
# 마크다운은 줄 끝 공백 두 개가 줄바꿈을 뜻한다
trim_trailing_whitespace = false

[*.bat]
end_of_line = crlf

[Makefile]
indent_style = tab
