{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "npx --yes skills@latest add \"${CLAUDE_PROJECT_DIR}/.agents/skills\" --skill '*' -a claude-code -y || exit 0",
            "timeout": 90,
            "statusMessage": "프로젝트 스킬 설치 중..."
          }
        ]
      }
    ]
  }
}
