{
  "$description": "Starter DTCG token set. Three tiers: primitive -> semantic -> component. Components must reference SEMANTIC tokens, never primitives. Replace values with the project's real design language.",

  "color": {
    "$description": "TIER 1 — PRIMITIVE: raw palette, brand-neutral names. Not for direct component use.",
    "white": { "$type": "color", "$value": "#ffffff" },
    "black": { "$type": "color", "$value": "#0a0a0a" },
    "neutral": {
      "50":  { "$type": "color", "$value": "#f7f7f8" },
      "100": { "$type": "color", "$value": "#ededf0" },
      "300": { "$type": "color", "$value": "#c9c9d1" },
      "500": { "$type": "color", "$value": "#6b6b76" },
      "700": { "$type": "color", "$value": "#3a3a42" },
      "900": { "$type": "color", "$value": "#18181b" }
    },
    "brand": {
      "500": { "$type": "color", "$value": "#2563eb" },
      "600": { "$type": "color", "$value": "#1d4ed8" }
    },
    "danger":  { "500": { "$type": "color", "$value": "#dc2626" } },
    "success": { "500": { "$type": "color", "$value": "#16a34a" } }
  },

  "semantic": {
    "$description": "TIER 2 — SEMANTIC: role-based. THIS is what components consume. Remap these for dark mode / themes.",
    "color": {
      "bg": {
        "surface":       { "$type": "color", "$value": "{color.white}" },
        "surface-raised":{ "$type": "color", "$value": "{color.neutral.50}" },
        "muted":         { "$type": "color", "$value": "{color.neutral.100}" }
      },
      "text": {
        "default": { "$type": "color", "$value": "{color.neutral.900}" },
        "muted":   { "$type": "color", "$value": "{color.neutral.500}" },
        "on-accent": { "$type": "color", "$value": "{color.white}" }
      },
      "border": {
        "default": { "$type": "color", "$value": "{color.neutral.300}" }
      },
      "accent": {
        "default": { "$type": "color", "$value": "{color.brand.500}" },
        "hover":   { "$type": "color", "$value": "{color.brand.600}" }
      },
      "feedback": {
        "danger":  { "$type": "color", "$value": "{color.danger.500}" },
        "success": { "$type": "color", "$value": "{color.success.500}" }
      }
    }
  },

  "space": {
    "$description": "TIER 1 — PRIMITIVE spacing scale (base 4).",
    "0": { "$type": "dimension", "$value": "0px" },
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "6": { "$type": "dimension", "$value": "24px" },
    "8": { "$type": "dimension", "$value": "32px" }
  },
  "semantic-space": {
    "$description": "TIER 2 — semantic spacing roles.",
    "inset": {
      "sm": { "$type": "dimension", "$value": "{space.2}" },
      "md": { "$type": "dimension", "$value": "{space.4}" },
      "lg": { "$type": "dimension", "$value": "{space.6}" }
    },
    "gap": {
      "sm": { "$type": "dimension", "$value": "{space.2}" },
      "md": { "$type": "dimension", "$value": "{space.4}" }
    }
  },

  "radius": {
    "none": { "$type": "dimension", "$value": "0px" },
    "control": { "$type": "dimension", "$value": "8px" },
    "card": { "$type": "dimension", "$value": "12px" },
    "pill": { "$type": "dimension", "$value": "9999px" }
  },

  "font": {
    "family": {
      "body":    { "$type": "fontFamily", "$value": ["Inter", "system-ui", "sans-serif"] },
      "display": { "$type": "fontFamily", "$value": ["Inter", "system-ui", "sans-serif"] }
    },
    "weight": {
      "regular": { "$type": "fontWeight", "$value": 400 },
      "medium":  { "$type": "fontWeight", "$value": 500 },
      "bold":    { "$type": "fontWeight", "$value": 700 }
    },
    "size": {
      "sm":   { "$type": "dimension", "$value": "14px" },
      "base": { "$type": "dimension", "$value": "16px" },
      "lg":   { "$type": "dimension", "$value": "20px" },
      "xl":   { "$type": "dimension", "$value": "28px" }
    }
  },

  "text-style": {
    "$description": "Composite typography tokens.",
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.body}",
        "fontWeight": "{font.weight.regular}",
        "fontSize": "{font.size.base}",
        "lineHeight": "1.5"
      }
    },
    "heading": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.display}",
        "fontWeight": "{font.weight.bold}",
        "fontSize": "{font.size.xl}",
        "lineHeight": "1.2"
      }
    }
  },

  "motion": {
    "duration": {
      "fast":   { "$type": "duration", "$value": "150ms" },
      "normal": { "$type": "duration", "$value": "250ms" }
    },
    "easing": {
      "standard": { "$type": "cubicBezier", "$value": [0.2, 0, 0, 1] }
    }
  },

  "breakpoint": {
    "$description": "Drive responsive switches from these, not magic numbers.",
    "sm": { "$type": "dimension", "$value": "640px" },
    "md": { "$type": "dimension", "$value": "768px" },
    "lg": { "$type": "dimension", "$value": "1024px" }
  }
}
