# 줄바꿈은 저장소와 체크아웃 양쪽에서 LF 로 고정합니다.
# 개인의 core.autocrlf 설정보다 이 선언이 우선합니다.
* text=auto eol=lf

# cmd 가 CRLF 를 기대합니다.
*.bat text eol=crlf
*.cmd text eol=crlf

# 바이너리는 변환하지 않습니다.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary

# 사람이 리뷰하지 않는 생성물입니다.
package-lock.json linguist-generated=true
